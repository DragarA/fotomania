          "401": {
            "description": "Password required or invalid token"
          },
          "404": {
            "description": "Catalogue not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get public catalogue data by public URL slug",
        "tags": [
          "public"
        ]
      }
    },
    "/public/catalogue/{slug}/collection/{collectionId}/photos": {
      "get": {
        "operationId": "PublicController_findCollectionPhotosBySlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Public URL slug",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collectionId",
            "required": true,
            "in": "path",
            "description": "Collection ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the photos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CollectionPhotoPublicResDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Password required or invalid token"
          },
          "404": {
            "description": "Collection not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get photos for a public collection",
        "tags": [
          "public"
        ]
      }
    },
    "/public/catalogue/{slug}/favourites": {
      "post": {
        "operationId": "PublicController_addFavourites",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Public URL slug",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddFavouritesReqDtoClass"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Favourites added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddFavouritesResDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload"
          },
          "401": {
            "description": "Password required or invalid token"
          },
          "404": {
            "description": "Catalogue not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Add favourite photos for a client",
        "tags": [
          "public"
        ]
      }
    }
