          },
          "name": {
            "type": "string",
            "description": "User Name"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "AuthLoginDtoClass": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User Email"
          },
          "password": {
            "type": "string",
            "description": "User Password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateCatalogueDtoClass": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
