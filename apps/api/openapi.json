        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Client session ID"
          },
          "email": {
            "type": "string",
            "description": "Client email address"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Session created timestamp"
          },
          "photoCount": {
            "type": "number",
            "description": "Array of favorited photos"
          }
        },
        "required": [
