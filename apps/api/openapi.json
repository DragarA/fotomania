            "description": "Password for protected catalogue",
            "example": "secret123"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateCatalogueDtoClass": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Catalogue title",
            "example": "Summer Wedding 2024"
          },
          "description": {
            "type": "string",
            "description": "Catalogue description",
            "example": "Beautiful moments from our summer wedding"
          },
          "password": {
            "type": "string",
            "description": "Password for protected catalogue",
            "example": "secret123"
          }
        }
      }
